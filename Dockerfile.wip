WORKDIR /tmp
ENV LD_LIBRARY_PATH=/usr/local/ssl/lib:/usr/local/lib64:/usr/local/lib:/usr/lib
ENV PKG_CONFIG_PATH=/usr/lib/pkgconfig/openssl.pc
COPY openssl-patch-1.0.0.patch /tmp
RUN wget https://cache.ruby-lang.org/pub/ruby/1.8/ruby-1.8.7-p374.tar.gz && \
    tar -xzvf ruby-1.8.7-p374.tar.gz && \
    rm ruby-1.8.7-p374.tar.gz && \
    cd ruby-1.8.7-p374 && \
    # find / -name 'libssl.a' | xargs -I {} cp {} . && \
    # find / -name 'libcrypto.a' | xargs -I {} cp {} . && \
    # find / -name 'libz.a' | xargs -I {} cp {} . && \
