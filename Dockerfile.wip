    # ruby extconf.rb && cd /tmp/ruby-1.8.7-p374 && \
    # sed -i 's/$extobjs = "ext\/#{extinit.o} #{$extobjs}"/$extobjs = "#{$extobjs} libz.a libcrypto.a libssl.a"/' ext/extmk.rb && \
    # cat ext/extmk.rb && \
    # export LDFLAGS='-L/usr/lib' && \
    # export CPPFLAGS='-I/usr/include' && \
    CFLAGS="-fPIC" LDFLAGS='-L/usr/lib -L.' CPPFLAGS='-I/usr/include -I.' ./configure --build=$(uname -m)-unknown-linux-gnu --disable-shared && \
    make && \
    make install && cat ext/openssl/mkmf.log &&\
    rm -rf /tmp/ruby-1.8.7-p374
