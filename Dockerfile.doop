FROM ubuntu:14.04 as ruby-1.8.7

RUN apt-get update && apt-get install -y build-essential wget \
    # Required for buiding ruby from source
    git autoconf bison byacc gperf libssl-dev
RUN sed -i -e 's=^mozilla/DST_Root_CA_X3.crt=!mozilla/DST_Root_CA_X3.crt=' /etc/ca-certificates.conf && update-ca-certificates
RUN openssl version
RUN find / -name 'libssl.so*'
RUN find / -name 'libssl.a*'
RUN find / -name 'openssl.pc'
WORKDIR /tmp
ARG RUBY_VERSION=1.8.7-p374
ARG RUBY_GEMS_VERSION=1.8.30
ARG BUNDLER_VERSION=1.17.3
ARG RAKE_VERSION=0.8.7
RUN wget https://cache.ruby-lang.org/pub/ruby/1.8/ruby-${RUBY_VERSION}.tar.gz && \
    tar -xzvf ruby-${RUBY_VERSION}.tar.gz && \
    rm ruby-${RUBY_VERSION}.tar.gz && \
    cd ruby-${RUBY_VERSION} && \
    ./configure --build=$(uname -m)-unknown-linux-gnu && \
    make && \
    make install && cat ext/openssl/mkmf.log && \
    rm -rf /tmp/ruby-${RUBY_VERSION}
RUN ruby -ropenssl -e 'puts "OpenSSL Version : #{OpenSSL::OPENSSL_VERSION}"'
RUN wget https://github.com/rubygems/rubygems/releases/download/v${RUBY_GEMS_VERSION}/rubygems-${RUBY_GEMS_VERSION}.tgz && \
    tar -xzvf rubygems-${RUBY_GEMS_VERSION}.tgz && \
    rm rubygems-${RUBY_GEMS_VERSION}.tgz && \
    cd rubygems-${RUBY_GEMS_VERSION} && \
    ruby setup.rb && \
    rm -rf /tmp/rubygems-${RUBY_GEMS_VERSION}
RUN gem install bundler -v ${BUNDLER_VERSION}
RUN gem install rake -v ${RAKE_VERSION}
